GATHEROLL_ENVIRONMENT=development
GATHEROLL_WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://gatheroll:gatheroll@localhost:5432/gatheroll
GATHEROLL_RETENTION_DAYS=30

# Private development bucket. Never enable r2.dev or a public custom domain.
GATHEROLL_R2_ACCOUNT_ID=
GATHEROLL_R2_ACCESS_KEY_ID=
GATHEROLL_R2_SECRET_ACCESS_KEY=
GATHEROLL_R2_BUCKET_NAME=gatheroll-dev
# Optional override; otherwise derived from account ID.
GATHEROLL_R2_ENDPOINT=
GATHEROLL_PHOTO_BATCH_LIMIT=50
GATHEROLL_PHOTO_MAX_BYTES=26214400
GATHEROLL_PHOTO_THUMBNAIL_MAX_BYTES=262144
GATHEROLL_PHOTO_PARTICIPANT_LIMIT=500
GATHEROLL_PHOTO_PUT_TTL_SECONDS=900
GATHEROLL_PHOTO_GET_TTL_SECONDS=300
