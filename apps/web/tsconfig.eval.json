{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs", "moduleResolution": "node", "ignoreDeprecations": "6.0",
    "noEmit": false, "incremental": false, "outDir": ".eval-build", "rootDir": ".",
    "target": "ES2022", "plugins": []
  },
  "include": ["evaluation/**/*.ts", "features/cleanup/**/*.ts"],
  "exclude": ["node_modules", ".eval-build"]
}
